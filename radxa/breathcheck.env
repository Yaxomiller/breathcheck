# BreathCheck device configuration (Radxa road unit).
# Lives at /etc/breathcheck.env after install.
# After editing: sudo systemctl restart breathcheck

# --- Web ---
HH_WEB_HOST=0.0.0.0
HH_WEB_PORT=8000

# --- Display / kiosk ---
# 1 rotates the whole UI 180 degrees for a panel mounted upside down; 0 leaves
# it the right way up. Taps follow the rotation either way.
HH_SCREEN_INVERT=0
# Seconds the kiosk waits after desktop login before opening the UI, so the
# board, backend and sensor are all up first. Used by the autostart entry
# (kiosk.sh --boot-delay); running kiosk.sh by hand starts immediately.
HH_KIOSK_DELAY_SECONDS=60
# How large the whole UI is drawn. 1.0 is the panel's native size, 1.25 is a
# quarter bigger, 0.9 fits more on. Applies to both browsers.
HH_UI_SCALE=1.0

# --- DiDies breath board (STM32 SPI bridge) ---
HH_ANALYZER_MODE=spi
HH_SPI_DEVICE=/dev/spidev1.0
HH_SPI_SPEED_HZ=500000
HH_GPIO_CHIP=/dev/gpiochip1
HH_BOARD_ENABLE_GPIO=256
HH_READY_GPIO=257
HH_PUMP_GPIO=271
HH_RTIA_KOHM=4.0
HH_BOARD_RESET_SECONDS=0.1
HH_BOARD_BOOT_SECONDS=1.0

# --- Demo override ---
# 1 = every test reports clear: 0.000 %BAC, 0.000 cannabis confidence, verdict
# PASS, regardless of what the sensors measured. Raw curve logs stay truthful.
# Set to 1 before a demo, 0 for real readings and for any calibration work.
# NOTE: leaving this line out is NOT the same as 0 — the code defaults to 1.
HH_DEMO_FORCE_CLEAN=0

# Measurement cycle (seconds): purge -> baseline -> blow -> recovery. The blow
# window is the SCAN TIME setting in the app.
#
# The long purge existed to warm the PID lamp, which used to be lit only for
# the duration of each scan. With HH_PID_ALWAYS_ON=1 (the default) the lamp is
# held at thermal equilibrium, so the purge only has to settle the pump
# airflow and the baseline sits on a flat signal.
#
# If you set HH_PID_ALWAYS_ON=0, put HH_PURGE_SECONDS back to 15: on a cold
# lamp a short purge makes the drift fit extrapolate off-scale.
HH_PURGE_SECONDS=1
HH_BASELINE_SECONDS=4
HH_RECOVERY_SECONDS=5

# Keep the PID lamp lit between scans so its baseline is flat. Costs standby
# power and lamp hours; set to 0 to switch it per scan instead.
HH_PID_ALWAYS_ON=1

# --- Cannabis confidence ---
# A horizontal line at this many mV splits the exhale curve: the area above it
# is "upper", the area beneath is "lower". The confidence score shown under
# the cannabis reading is upper/lower, clamped to 0.000-1.000.
HH_CANNABIS_THRESHOLD_MV=500

# Alcohol-cell settle at app start
HH_SETTLE_SLOPE_NA_S=30
HH_STABILIZE_MAX_S=180

# Idle keepalive: reset the board if no valid frame for this many seconds
HH_STREAM_DEAD_SECONDS=10

# --- GPS ---
# nmea = serial GPS module, mock = fake fix for bench testing, off = disabled
HH_GPS_MODE=nmea
HH_GPS_SERIAL_PORT=/dev/ttyS0
HH_GPS_SERIAL_BAUD=9600

# --- Thermal receipt printer (ESC/POS over serial) ---
# serial = real printer, mock = log the receipt, off = disable printing
HH_PRINTER_MODE=serial
HH_PRINTER_DEVICE=/dev/ttyUSB0
HH_PRINTER_BAUD=9600
HH_PRINT_DEVICE_NAME="BREATHCHECK"
HH_STATION_NAME=""
HH_STATION_ADDRESS=""
HH_SERIAL_NUMBER=""

# --- Device identity (seeds the database on FIRST boot only;
#     afterwards edit these in the Settings screen) ---
HH_SET_NO="HH-001"
HH_AREA="ZONE 1"
HH_CALIBR_DATE="2026-07-01"

# Uncomment to store records outside the app folder:
# HH_DATA_DIR=/var/lib/breathcheck
